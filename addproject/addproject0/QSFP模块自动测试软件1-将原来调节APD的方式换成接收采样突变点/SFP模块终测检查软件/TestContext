using System;
using System.Threading;

namespace FibertopTest_Common
{
    /// <summary>
    /// 每个模块的独立测试上下文
    /// 
    /// 【这个类是做什么的？】
    /// 在原来的单线程代码中，TestSet.ch、TestResult 等变量是全局唯一的（static），
    /// 4个模块轮流测试时不会冲突。但改成多线程后，4个线程同时运行，
    /// 如果还用同一个全局变量，线程A设置 ch=0，线程B同时设置 ch=1，数据就乱了。
    /// 
    /// 解决方案：用 [ThreadStatic] 特性，让每个线程拥有自己独立的变量副本。
    /// 再用这个 TestContext 类来管理每个模块线程的状态。
    /// 
    /// 【工作原理】
    /// 每个模块线程启动时：
    ///   1. 设置 TestContext.Slot = 模块槽位号(1~4)
    ///   2. TestContext.TestSet.ch 会自动成为该线程的独立副本
    ///   3. 线程中所有对 TestSet.ch 的操作都只影响自己的副本，不会干扰其他线程
    /// </summary>
    public class TestContext
    {
        // ============================================================
        // 一、线程独立的测试状态
        // ============================================================

        /// <summary>
        /// 当前模块的槽位号（1~4），对应加热台上的物理槽位
        /// 每个线程只操作自己对应的槽位，不会冲突
        /// </summary>
        public int Slot { get; set; }

        /// <summary>
        /// 模块I2C操作对象 — 每个模块有独立的I2C通信通道
        /// （通过加热台的 TCP 转发，用 slot 参数区分不同模块）
        /// </summary>
        public ModuleTest ModuleTest { get; set; }

        /// <summary>
        /// I2C底层通信对象 — 每个模块独立
        /// </summary>
        public I2C I2C { get; set; }

        /// <summary>
        /// 测试模式：true=初测调试，false=终测检查
        /// </summary>
        public bool IsFirstTest { get; set; }

        /// <summary>
        /// 测试是否成功完成
        /// </summary>
        public bool TestSuccess { get; set; } = false;

        /// <summary>
        /// 测试状态文本（用于UI显示）
        /// </summary>
        public string StatusText { get; set; } = "等待开始...";

        /// <summary>
        /// 测试进度百分比（0~100）
        /// </summary>
        public int Progress { get; set; } = 0;

        /// <summary>
        /// 测试开始时间
        /// </summary>
        public DateTime StartTime { get; set; }

        /// <summary>
        /// 测试结束时间
        /// </summary>
        public DateTime EndTime { get; set; }

        /// <summary>
        /// 错误信息（测试失败时填写）
        /// </summary>
        public string ErrorMessage { get; set; } = "";

        /// <summary>
        /// 当前测试阶段的名称（如"接收调试"、"发射调试"等）
        /// </summary>
        public string CurrentPhase { get; set; } = "";

        // ============================================================
        // 二、线程静态变量（每个线程独立的全局状态副本）
        // ============================================================

        /// <summary>
        /// 当前线程的 TestContext 实例
        /// 用 [ThreadStatic] 确保每个线程有自己独立的副本
        /// 
        /// 【使用方式】
        /// 在测试线程的入口处设置：
        ///   TestContext.Current = myContext;
        /// 然后在任何地方都可以通过 TestContext.Current 访问当前线程的上下文
        /// </summary>
        [ThreadStatic]
        private static TestContext _current;

        /// <summary>
        /// 获取或设置当前线程的测试上下文
        /// </summary>
        public static TestContext Current
        {
            get { return _current; }
            set { _current = value; }
        }

        // ============================================================
        // 三、辅助方法
        // ============================================================

        /// <summary>
        /// 初始化线程上下文（在线程入口处调用）
        /// 将此 TestContext 设为当前线程的活动上下文
        /// </summary>
        public void Activate()
        {
            _current = this;
        }

        /// <summary>
        /// 获取模块的显示名称（如"模块1"、"模块2"）
        /// </summary>
        public string DisplayName
        {
            get { return "模块" + Slot.ToString(); }
        }

        /// <summary>
        /// 获取测试耗时
        /// </summary>
        public TimeSpan Duration
        {
            get
            {
                if (EndTime > StartTime)
                    return EndTime - StartTime;
                return TimeSpan.Zero;
            }
        }

        /// <summary>
        /// 获取测试结果状态字符串
        /// </summary>
        public string ResultString
        {
            get
            {
                if (TestSuccess)
                    return "✓ 通过";
                else if (string.IsNullOrEmpty(ErrorMessage) == false)
                    return "✗ 失败: " + ErrorMessage;
                else
                    return StatusText;
            }
        }
    }
}